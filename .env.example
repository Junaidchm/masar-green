# Copy this file to .env and fill in local values, or configure the same
# variables as Replit Secrets. The app reads them from the process environment;
# it does not load .env automatically.

# Required by the API. Use a long random value, for example:
#   openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-development-secret

# Runtime
NODE_ENV=development
PORT=8080
BASE_PATH=/
LOG_LEVEL=info

# Local Vite dev proxy target for /api (defaults to http://localhost:8080).
API_PROXY_TARGET=http://localhost:8080

# Optional: Replit AI Integrations for the read-only assistant.
# Leave unset to keep the assistant disabled (it returns 503).
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=

# Optional: host used by scripts/test-engagement.mjs.
REPLIT_DEV_DOMAIN=

# Unused PostgreSQL template package (lib/db) only. Not used by Masar Green.
# DATABASE_URL=
